"""
绝地潜兵2 自动呼叫战备 - PyQt6 界面
Helldivers 2 Auto Stratagem Caller - PyQt6 GUI

Features:
- 黑黄配色 Helldivers 2 主题
- 分类标签页浏览战备
- 搜索 / 过滤
- 按键绑定（按下按键直接捕获）
- 全局快捷键: 游戏内一键触发战备
- 支持右侧 Ctrl、方向键等特殊按键
"""

import sys
import threading
import keyboard

from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QTabWidget, QTableWidget, QTableWidgetItem, QPushButton,
    QLineEdit, QLabel, QDialog, QFormLayout, QDoubleSpinBox,
    QStatusBar, QHeaderView, QMenu, QMessageBox, QGroupBox,
    QAbstractItemView, QSizePolicy, QSpacerItem,
)
from PyQt6.QtCore import Qt, pyqtSignal, QTimer
from PyQt6.QtGui import QFont, QColor, QAction, QIcon

from stratagems import (
    STRATAGEMS,
    get_categories,
    get_stratagems_by_category,
    search_stratagems,
    command_to_string,
)
from config import load_config, save_config, DEFAULT_KEY_BINDINGS
from executor import execute_stratagem


